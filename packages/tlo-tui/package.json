{
  "name": "@2digits/tlo-tui",
  "version": "0.0.0",
  "private": true,
  "description": "Teamleader Orbit terminal UI (OpenTUI) on top of the local tlo-mcp gateway",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2digits-agency/configs.git",
    "directory": "packages/tlo-tui"
  },
  "bin": {
    "tlo": "./src/main.tsx"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "demo": "bun src/main.tsx --demo",
    "start": "bun src/main.tsx",
    "test": "vp test",
    "test:ui": "bun test ./test-ui",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/atom-react": "catalog:",
    "@effect/platform-node": "catalog:",
    "@opentui/core": "catalog:",
    "@opentui/react": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "scheduler": "catalog:"
  },
  "devDependencies": {
    "@2digits/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
