{
  "name": "@2digits/cli",
  "version": "2.0.36",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2digits-agency/configs.git",
    "directory": "packages/cli"
  },
  "bin": {
    "cli": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/bin.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "bin": "oxnode ./src/bin.ts",
    "build": "vp pack --minify",
    "dev": "vp pack --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "tsrs --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "effect": "catalog:",
    "nypm": "catalog:",
    "pkg-types": "catalog:"
  },
  "devDependencies": {
    "@2digits/tsconfig": "workspace:*",
    "@effect/vitest": "catalog:",
    "@oxc-node/cli": "catalog:",
    "publint": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
