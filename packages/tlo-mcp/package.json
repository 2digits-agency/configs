{
  "name": "@2digits/tlo-mcp",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2digits-agency/configs.git",
    "directory": "packages/tlo-mcp"
  },
  "bin": {
    "tlo-mcp": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack --minify --config-loader unconfig",
    "dev": "vp pack --watch --config-loader unconfig",
    "run": "vp run build && node ./dist/bin.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@opentunnel/client": "catalog:",
    "@yielded/oauth": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@2digits/tsconfig": "workspace:*",
    "@arethetypeswrong/core": "catalog:",
    "@effect/vitest": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "v26.11.1"
  },
  "public": true
}
