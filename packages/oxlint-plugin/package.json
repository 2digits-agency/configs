{
  "name": "@2digits/oxlint-plugin",
  "version": "0.3.5",
  "description": "Custom Oxlint rules for 2digits projects.",
  "keywords": [
    "2digits",
    "oxlint",
    "oxlint-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2digits-agency/configs.git",
    "directory": "packages/oxlint-plugin"
  },
  "files": [
    "NOTICE",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack --minify",
    "dev": "vp pack --watch",
    "test": "vitest run",
    "types": "tsrs --noEmit"
  },
  "dependencies": {
    "@oxlint/plugins": "catalog:",
    "effect": "catalog:",
    "effect-oxlint": "catalog:"
  },
  "devDependencies": {
    "@2digits/tsconfig": "workspace:*",
    "@arethetypeswrong/core": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@typescript/native-preview": "catalog:",
    "dedent": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "public": true
}
