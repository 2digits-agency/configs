{
  "name": "@2digits/oxlint-config",
  "version": "2.2.0",
  "description": "Minimal Oxlint config for 2digits projects.",
  "keywords": [
    "oxlint-config"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2digits-agency/configs.git",
    "directory": "packages/oxlint-config"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack --minify",
    "dev": "vp pack --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "types": "tsrs --noEmit"
  },
  "dependencies": {
    "@2digits/constants": "workspace:*",
    "@2digits/oxlint-plugin": "workspace:*",
    "@stylistic/eslint-plugin": "catalog:",
    "eslint-plugin-de-morgan": "catalog:",
    "eslint-plugin-zod": "catalog:",
    "local-pkg": "catalog:",
    "oxlint-flat-config": "catalog:"
  },
  "devDependencies": {
    "@2digits/eslint-config": "workspace:*",
    "@2digits/tsconfig": "workspace:*",
    "@arethetypeswrong/core": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "dedent": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "publint": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:"
  },
  "public": true
}
