{
  "name": "@2digits/oxlint-config",
  "version": "0.8.0",
  "description": "Minimal Oxlint config for 2digits projects.",
  "keywords": [
    "oxlint-config"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2digits-agency/configs.git",
    "directory": "packages/oxlint-config"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./base": "./dist/base.mjs",
    "./effect": "./dist/effect.mjs",
    "./typescript": "./dist/typescript.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./base": "./dist/base.mjs",
      "./effect": "./dist/effect.mjs",
      "./typescript": "./dist/typescript.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack --minify",
    "dev": "vp pack --watch",
    "test": "vp test run",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "@2digits/constants": "workspace:*",
    "@stylistic/eslint-plugin": "catalog:",
    "defu": "catalog:",
    "eslint-plugin-react-compiler": "catalog:",
    "eslint-plugin-zod": "catalog:"
  },
  "devDependencies": {
    "@2digits/eslint-config": "workspace:*",
    "@2digits/tsconfig": "workspace:*",
    "@arethetypeswrong/core": "catalog:",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:"
  },
  "public": true
}
